# Supabase project URL（公开值）
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Supabase anon key（前端公开使用，不要填 service_role）
SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Cloudflare Turnstile site key（前端公开使用，必须以 0x4 开头）
TURNSTILE_SITE_KEY=0x4AAAAAAA-EXAMPLE-PLACEHOLDER

# 本文件可提交。复制为 .env 并填写真实值：
#   cp .env.example .env
# .env 已在 .gitignore 中被忽略。

# ============ 爱发电（Afdian）付费 LUT 集成 ============
# 下面三个变量只用于 Supabase Edge Function,**不要** 填到 .env,
# 也不要进 build-config.sh 注入前端。 用 supabase secrets set 设置:
#
#   supabase secrets set \
#     AFDIAN_USER_ID=your-afdian-user-id \
#     AFDIAN_TOKEN=your-afdian-api-token
#
# AFDIAN_WEBHOOK_PUBLIC_KEY（验签公钥）固定在 afdian-webhook/index.ts
# 顶部, 不进 secrets。 如果爱发电未来轮换公钥, 需要更新源码。
#
# AFDIAN_USER_ID=your-afdian-user-id
# AFDIAN_TOKEN=your-afdian-api-token

